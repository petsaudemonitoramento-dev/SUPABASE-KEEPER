# Supabase central usado pelo Keeper. O browser nunca recebe estas credenciais.
SUPABASE_URL=https://SEU-PROJETO-CENTRAL.supabase.co
SUPABASE_SECRET_KEY=sb_secret_COLOQUE_AQUI

# Gere 32 bytes em base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEEPER_ENCRYPTION_KEY=

# Código necessário para criar contas no Keeper. Troque quando quiser bloquear novos cadastros.
KEEPER_SIGNUP_CODE=

# O Vercel Cron envia este valor em Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

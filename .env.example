# Banco PostgreSQL central do Keeper no Neon.
# Copie a connection string do projeto Neon. Nunca exponha no navegador.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Gere 32 bytes em base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEEPER_ENCRYPTION_KEY=

# Código necessário para criar contas no Keeper.
KEEPER_SIGNUP_CODE=

# Segredo usado para autenticar as rotas de cron.
CRON_SECRET=
